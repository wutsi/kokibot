{
  "assistant": {
    "max-iterations": 30
  },
  "heartbeat": {
    "frequency": "1h"
  },
  "llm": {
    "type": "${KOKIBOT_LLM_TYPE}",
    "api-key": "${KOKIBOT_LLM_API_KEY}",
    "model": "${KOKIBOT_LLM_MODEL}",
    "streaming": true,
    "temperature": 0.1
  },
  "channels": [
    {
      "type": "${KOKIBOT_CHANNEL_TYPE}",
      "token": "${KOKIBOT_CHANNEL_TOKEN}"
    }
  ],
  "memory": {
    "window": "5d",
    "compaction-frequency": "6h",
    "max-length": 2048
  },
  "marketplaces": [
    {
      "name": "obsidian",
      "repo-url": "https://github.com/kepano/obsidian-skills.git",
      "skill-whitelist": [
        "obsidian-markdown",
        "obsidian-bases",
        "obsidian-cli",
        "json-canvas"
      ]
    },
    {
      "name": "anthropics",
      "repo-url": "https://github.com/anthropics/skills.git",
      "skill-whitelist": [
        "pdf",
        "docx",
        "pptx",
        "xlsx"
      ]
    }
  ]
}
