{
  "assistant": {
    "max-iterations": 10
  },
  "llm": {
    "type": "deepseek",
    "api-key": "${DEEPSEEK_API_KEY}",
    "model": "deepseek-v4-flash",
    "temperature": 0.7,
    "read-timeout-millis": 30000,
    "connect-timeout-millis": 30000,
    "max-tokens": 2048
  },
  "channels": [
    {
      "type": "telegram",
      "token": "${TELEGRAM_TOKEN}"
    }
  ],
  "heartbeat": {
    "frequency": "30m"
  },
  "memory": {
    "window": "3d",
    "compaction-frequency": "12h"
  }
}
