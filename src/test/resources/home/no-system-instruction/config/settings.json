{
  "llm": {
    "type": "deepseek",
    "api_key": "${DEEPSEEK_API_KEY}",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "max_tokens": 2048,
    "read-timeout-millis": 30000,
    "connect-timeout-millis": 30000,
    "max-tokens": 2048
  },
  "channels": [
    {
      "type": "telegram",
      "token": "${TELEGRAM_TOKEN}"
    }
  ],
  "mail": {
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "username": "foo",
      "from": "yo.man@gmail.com"
    },
    "imaps": {
      "host": "imap.example.com",
      "port": 993,
      "username": "foo",
      "password": "bar"
    }
  }
}
